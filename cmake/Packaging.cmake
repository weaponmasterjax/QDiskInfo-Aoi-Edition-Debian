set(CPACK_GENERATOR "DEB")
set(CPACK_PACKAGE_NAME "qdiskinfo-aoi")
set(CPACK_PACKAGE_VENDOR "QDiskInfo-Aoi-Edition-Debian")
set(CPACK_PACKAGE_HOMEPAGE_URL "https://github.com/weaponmasterjax/QDiskInfo-Aoi-Edition-Debian")
set(CPACK_PACKAGE_CONTACT "Weaponmasterjax <42597871+weaponmasterjax@users.noreply.github.com>")
set(CPACK_PACKAGE_DESCRIPTION_SUMMARY "CrystalDiskInfo alternative for Linux (Aoi Edition)")
set(CPACK_PACKAGE_DESCRIPTION
    "QDiskInfo is a Qt6 frontend for smartctl (smartmontools) that provides a user experience similar to CrystalDiskInfo, displaying S.M.A.R.T. health, temperature, and attribute data for ATA, SCSI, and NVMe drives.\nThis Debian Aoi Edition bundles dynamic CrystalDiskInfo Aoi anime themes with an in-app Theme switcher and Random theme mode.")
set(CPACK_PACKAGING_INSTALL_PREFIX "/usr")
set(CPACK_STRIP_FILES ON)

if(NOT DEFINED CPACK_PACKAGE_VERSION OR CPACK_PACKAGE_VERSION STREQUAL "")
    set(CPACK_PACKAGE_VERSION "${PROJECT_VERSION}")
endif()
if(NOT DEFINED CPACK_DEBIAN_PACKAGE_RELEASE OR CPACK_DEBIAN_PACKAGE_RELEASE STREQUAL "")
    set(CPACK_DEBIAN_PACKAGE_RELEASE "1")
endif()

set(CPACK_DEBIAN_PACKAGE_NAME "qdiskinfo-aoi")
set(CPACK_DEBIAN_PACKAGE_MAINTAINER "${CPACK_PACKAGE_CONTACT}")
set(CPACK_DEBIAN_PACKAGE_HOMEPAGE "${CPACK_PACKAGE_HOMEPAGE_URL}")
set(CPACK_DEBIAN_PACKAGE_SECTION "utils")
set(CPACK_DEBIAN_PACKAGE_PRIORITY "optional")
set(CPACK_DEBIAN_PACKAGE_SHLIBDEPS ON)
set(CPACK_DEBIAN_PACKAGE_DEPENDS "smartmontools, pkexec, qt6-wayland, qt6-svg-plugins | libqt6svg6")
set(CPACK_DEBIAN_PACKAGE_RECOMMENDS "hicolor-icon-theme")
set(CPACK_DEBIAN_PACKAGE_SUGGESTS "qt6ct")
set(CPACK_DEBIAN_PACKAGE_PROVIDES "qdiskinfo")
set(CPACK_DEBIAN_PACKAGE_CONFLICTS "qdiskinfo")
set(CPACK_DEBIAN_PACKAGE_REPLACES "qdiskinfo")
set(CPACK_DEBIAN_COMPRESSION_TYPE "xz")
set(CPACK_DEBIAN_FILE_NAME "DEB-DEFAULT")
set(CPACK_DEBIAN_PACKAGE_CONTROL_STRICT_PERMISSION TRUE)

include(CPack)
